+static gboolean 
+is_vpn_notification_pref(const char *pref) 
+{
+	g_return_val_if_fail(pref != NULL, FALSE);
+
+	for (int i = 0; i < G_N_ELEMENTS (vpn_reasons_prefs); i++) {
+		if(!strcmp(pref, vpn_reasons_prefs[i])) {
+			return TRUE;
+		}
+	}
+
+    return FALSE;
+}
